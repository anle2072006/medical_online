{
  "openapi": "3.0.3",
  "info": {
    "title": "SINA Clinic - Scheduling Service",
    "version": "1.0.0",
    "description": "Ca lam viec (tu duyet 5 luat), slot, nghi phep, dat/huy/doi lich, FSM lich hen. Moi loi tra ve dang { error: MA_LOI, message }."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
