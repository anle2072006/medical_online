          "Scheduling Service"
        ],
        "operationId": "get_scheduling__doctors",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Thanh cong"
          },
          "401": {
            "description": "UNAUTHORIZED"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Vai tro: moi nguoi dung da dang nhap."
      }
    },
