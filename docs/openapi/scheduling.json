    "/api/scheduling/shifts": {
      "post": {
        "summary": "Dang ky ca; he thong tu duyet theo 5 luat",
        "tags": [
          "Scheduling Service"
        ],
        "operationId": "post_scheduling__shifts",
        "parameters": [],
        "responses": {
          "200": {
            "description": "201 { id, status: APPROVED|REJECTED, rejectCode? }"
          },
          "201": {
            "description": "201 { id, status: APPROVED|REJECTED, rejectCode? }"
          },
          "400": {
            "description": "INVALID_SHIFT"
          },
          "401": {
            "description": "UNAUTHORIZED"
          },
          "403": {
            "description": "FORBIDDEN"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "description": "Vai tro: doctor.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "weekday": {
                    "type": "string",
                    "description": "0..6"
                  },
                  "startTime": {
                    "type": "string",
                    "description": "HH:MM"
                  },
                  "endTime": {
                    "type": "string",
                    "description": "HH:MM"
                  },
                  "slotMinutes": {
                    "type": "string",
                    "description": "15|20|30|45"
                  },
                  "fee": {
                    "type": "string",
                    "description": "number(1..10000000)"
                  },
                  "startDate": {
                    "type": "string",
                    "description": "YYYY-MM-DD"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/scheduling/shifts/mine": {
      "get": {
        "summary": "Ca da dang ky cua toi",
